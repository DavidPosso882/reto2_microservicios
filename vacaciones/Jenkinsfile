// Reto 7 — CI de vacaciones-service (Ruby 3.3 + Minitest, stdlib).
// Etapas: Checkout -> Build -> Test -> SonarQube -> Package -> E2E Tests.
// Top-level 'agent none' con agente propio por etapa (los agentes docker no
// se anidan: ver empleados/Jenkinsfile). Misma convención: fallos -> UNSTABLE.
pipeline {
    agent none

    stages {
        stage('Checkout') {
            agent any
            steps {
                echo 'Código fuente obtenido del SCM configurado en el job'
            }
        }

        stage('Build') {
            agent {
                docker {
                    image 'ruby:3.3-slim'
                    args '-v jenkins-ruby:/usr/local/bundle'
                }
            }
            steps {
                dir('vacaciones') {
                    // Sin dependencias externas: basta verificar el intérprete.
                    // run_all.rb usa solo stdlib (sin bundle install).
                    sh 'ruby -v'
                }
            }
        }

        stage('Test') {
            agent {
                docker {
                    image 'ruby:3.3-slim'
                    args '-v jenkins-ruby:/usr/local/bundle'
                }
            }
            steps {
                dir('vacaciones') {
                    // El '|| true' deja que el pipeline llegue al bloque post y
                    // publique el reporte; es el paso junit quien marca UNSTABLE.
                    sh 'ruby tests/run_all.rb || true'
                }
            }
            post {
                always {
                    junit 'vacaciones/reports/junit.xml'
                    recordCoverage(
                        tools: [[parser: 'COBERTURA', pattern: 'vacaciones/reports/coverage/coverage.xml']],
                        sourceCodeRetention: 'EVERY_BUILD'
                    )
                }
            }
        }

        stage('SonarQube') {
            // Scanner CLI 5.0.1 (pin: compatible con SonarQube 9.9).
            // Host network para llegar a localhost:9000; login Basic (SQ 9.9
            // rechaza Bearer). La cobertura la generó Test (Cobertura XML).
            agent {
                docker {
                    image 'sonarsource/sonar-scanner-cli:5.0.1'
                    args '--network host'
                }
            }
            steps {
                dir('vacaciones') {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SQ_TOKEN')]) {
                        sh 'sonar-scanner -Dsonar.login=${SQ_TOKEN} -Dsonar.qualitygate.wait=true -Dsonar.qualitygate.timeout=300'
                    }
                }
            }
        }

        stage('Package') {
            agent {
                docker {
                    image 'python:3.11-slim'
                    args '-v /var/run/docker.sock:/var/run/docker.sock --group-add 983 --network host'
                }
            }
            steps {
                sh 'python3 scripts/fetch-compose.py'
                sh 'TAG=${BUILD_NUMBER} .ci-tools/docker-compose -p reto7-e2e -f docker-compose.yml -f docker-compose.registry.yml build vacaciones-service'
                sh 'TAG=${BUILD_NUMBER} .ci-tools/docker-compose -p reto7-e2e -f docker-compose.yml -f docker-compose.registry.yml push vacaciones-service'
                sh 'TAG=latest .ci-tools/docker-compose -p reto7-e2e -f docker-compose.yml -f docker-compose.registry.yml build vacaciones-service'
                sh 'TAG=latest .ci-tools/docker-compose -p reto7-e2e -f docker-compose.yml -f docker-compose.registry.yml push vacaciones-service'
            }
        }

        stage('E2E Tests') {
            // Igual que empleados (proyecto reto7-e2e aislado). No paralelizar
            // E2E entre pipelines: puertos fijos compartidos.
            agent {
                docker {
                    image 'python:3.11-slim'
                    args '-v /var/run/docker.sock:/var/run/docker.sock --group-add 983 --network host'
                }
            }
            steps {
                sh 'python3 scripts/fetch-compose.py'
                sh '.ci-tools/docker-compose -p reto7-e2e -f docker-compose.yml up -d --build api-gateway'
                sh 'BASE_URL=http://localhost:8080 python3 scripts/wait-for-e2e-ready.py'
                sh 'cd e2e-tests && ([ -x .venv/bin/behave ] || (python3 -m venv .venv && .venv/bin/pip install -q -r requirements.txt)) && BASE_URL=http://localhost:8080 ./run_bdd.sh || true'
            }
            post {
                always {
                    junit 'e2e-tests/reports/TESTS-*.xml'
                    cucumber(jsonReportDirectory: 'e2e-tests/reports', fileIncludePattern: '**/cucumber.json', buildStatus: 'UNSTABLE')
                    publishHTML(target: [reportDir: 'e2e-tests/reports', reportFiles: 'cucumber.html', reportName: 'Reporte BDD', keepAll: true, alwaysLinkToLastBuild: true])
                    sh '.ci-tools/docker-compose -p reto7-e2e logs --no-color > docker-logs.txt || true'
                    sh '.ci-tools/docker-compose -p reto7-e2e down -v || true'
                    archiveArtifacts artifacts: 'docker-logs.txt', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline finalizado'
        }
        success {
            echo 'Build y tests exitosos'
        }
        unstable {
            echo 'El build compiló pero hay pruebas fallando'
        }
        failure {
            echo 'El pipeline ha fallado'
        }
    }
}
