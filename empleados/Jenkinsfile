// Reto 7 P2 — CI de empleados-service (Java 21 + Maven).
// Etapas: Checkout (automático desde SCM) -> Build -> Test con publicación
// de resultados (junit) y cobertura (recordCoverage JaCoCo) en post/always,
// para que el reporte se publique aun cuando las pruebas fallen.
// Convención: pruebas fallidas -> UNSTABLE (amarillo, lo marca junit);
// lo que no compila -> FAILURE (rojo). El empaquetado (P4) solo corre en verde.
pipeline {
    agent {
        docker {
            // Misma toolchain que el Dockerfile del servicio (Java 21 + Maven 3.9).
            image 'maven:3.9-eclipse-temurin-21'
            // Socket para Testcontainers (BD real en integración) + caché de
            // dependencias para no descargar todo en cada build.
            // --network host: el firewall del host filtra el tráfico del bridge
            // hacia los puertos efímeros que Testcontainers publica (hasta un
            // puerto cerrado da timeout desde el puente); con host network el
            // agente comparte el stack del host y llega a 127.0.0.1:port.
            // --group-add 983 se mantiene: sin él, el uid 1000 no lee el socket.
            args '-v /var/run/docker.sock:/var/run/docker.sock -v jenkins-m2:/root/.m2 --group-add 983 --network host'
        }
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Código fuente obtenido del SCM configurado en el job'
            }
        }

        stage('Build') {
            steps {
                dir('empleados') {
                    sh 'mvn clean compile -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir('empleados') {
                    // -Dmaven.test.failure.ignore=true: deja que surefire+failsafe
                    // terminen y generen los XML; es el paso junit quien marca
                    // el build como UNSTABLE si hay fallos.
                    // TESTCONTAINERS_RYUK_DISABLED: en CI el reaper Ryuk no es
                    // alcanzable desde el agente; la limpieza la hace el shutdown
                    // hook de la JVM al terminar surefire (práctica estándar CI).
                    // TESTCONTAINERS_HOST_OVERRIDE: con --network host el agente
                    // ve al host como 127.0.0.1 y así llega a los puertos que
                    // Testcontainers publica (el firewall filtra el puente).
                    sh 'TESTCONTAINERS_RYUK_DISABLED=true TESTCONTAINERS_HOST_OVERRIDE=127.0.0.1 mvn verify -Dmaven.test.failure.ignore=true'
                }
            }
            post {
                always {
                    junit 'empleados/target/surefire-reports/*.xml, empleados/target/failsafe-reports/*.xml'
                    recordCoverage(
                        tools: [[parser: 'JACOCO', pattern: 'empleados/target/site/jacoco/jacoco.xml']],
                        sourceCodeRetention: 'EVERY_BUILD'
                    )
                }
            }
        }

        stage('SonarQube') {
            steps {
                dir('empleados') {
                    // El reporte JaCoCo lo generó la etapa Test en este workspace.
                    // localhost: el agente usa host network (etapas Build/Test).
                    // sonar.qualitygate.wait: el propio scanner espera el Quality
                    // Gate y falla el build si no pasa. Decisión frente a
                    // waitForQualityGate+webhook: cero estado en Jenkins (sin
                    // servidor pre-configurado ni webhook), todo versionado aquí.
                    // QG rojo -> FAILURE: no se empaqueta sin calidad suficiente.
                    // NOTA: la variable se llama SQ_TOKEN y no SONAR_TOKEN porque
                    // ese nombre colisiona con la variable de entorno del controller
                    // (inyectada por Compose para JCasC) y el binding llegaba vacío.
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SQ_TOKEN')]) {
                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                                -Dsonar.host.url=http://localhost:9000 \
                                -Dsonar.token=${SQ_TOKEN} \
                                -Dsonar.projectKey=empleados-service \
                                -Dsonar.qualitygate.wait=true \
                                -Dsonar.qualitygate.timeout=300
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline finalizado'
        }
        success {
            echo 'Build y tests exitosos'
        }
        unstable {
            echo 'El build compiló pero hay pruebas fallando'
        }
        failure {
            echo 'El pipeline ha fallado'
        }
    }
}
