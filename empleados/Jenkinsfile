// Reto 7 — CI de empleados-service (Java 21 + Maven).
// Etapas: Checkout -> Build -> Test -> SonarQube -> Package -> E2E Tests.
// Top-level 'agent none' con agente propio por etapa: los agentes docker
// NO se pueden anidar (una etapa con agente docker dentro de un agente docker
// ejecuta 'docker pull' dentro del contenedor -> 127 + JENKINS-30600).
// Convención: pruebas fallidas -> UNSTABLE (lo marca junit); no compila,
// QG rojo o E2E rojo -> FAILURE. Package/E2E solo corren en verde.
pipeline {
    agent none

    stages {
        stage('Checkout') {
            agent any
            steps {
                echo 'Código fuente obtenido del SCM configurado en el job'
            }
        }

        stage('Build') {
            agent {
                docker {
                    // Misma toolchain que el Dockerfile del servicio.
                    image 'maven:3.9-eclipse-temurin-21'
                    // Socket para Testcontainers + caché m2. Host network: el
                    // firewall filtra puente->puertos efímeros; group-add 983
                    // para leer el socket (root:docker 660).
                    args '-v /var/run/docker.sock:/var/run/docker.sock -v jenkins-m2:/root/.m2 --group-add 983 --network host'
                }
            }
            steps {
                dir('empleados') {
                    sh 'mvn clean compile -DskipTests'
                }
            }
        }

        stage('Test') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-21'
                    args '-v /var/run/docker.sock:/var/run/docker.sock -v jenkins-m2:/root/.m2 --group-add 983 --network host'
                }
            }
            steps {
                dir('empleados') {
                    // -Dmaven.test.failure.ignore=true: deja que surefire+failsafe
                    // terminen y generen los XML; es el paso junit quien marca
                    // el build como UNSTABLE si hay fallos.
                    // RYUK_DISABLED + HOST_OVERRIDE: ver comentario del agente.
                    sh 'TESTCONTAINERS_RYUK_DISABLED=true TESTCONTAINERS_HOST_OVERRIDE=127.0.0.1 mvn verify -Dmaven.test.failure.ignore=true'
                }
            }
            post {
                always {
                    junit 'empleados/target/surefire-reports/*.xml, empleados/target/failsafe-reports/*.xml'
                    recordCoverage(
                        tools: [[parser: 'JACOCO', pattern: 'empleados/target/site/jacoco/jacoco.xml']],
                        sourceCodeRetention: 'EVERY_BUILD'
                    )
                }
            }
        }

        stage('SonarQube') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-21'
                    args '-v /var/run/docker.sock:/var/run/docker.sock -v jenkins-m2:/root/.m2 --group-add 983 --network host'
                }
            }
            steps {
                dir('empleados') {
                    // JaCoCo lo generó Test en este workspace (el checkout por
                    // etapa conserva untracked: target/, reports/).
                    // sonar.qualitygate.wait: el scanner espera el QG y falla si
                    // no pasa (cero estado en Jenkins). localhost: host network.
                    // sonar.login (Basic): SQ 9.9 rechaza Bearer de sonar.token.
                    // SQ_TOKEN (no SONAR_TOKEN): ese nombre colisiona con el env
                    // del controller y el binding llegaba vacío.
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SQ_TOKEN')]) {
                        sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.host.url=http://localhost:9000 -Dsonar.login=${SQ_TOKEN} -Dsonar.projectKey=empleados-service -Dsonar.qualitygate.wait=true -Dsonar.qualitygate.timeout=300'
                    }
                }
            }
        }

        stage('Package') {
            // Agente python: binario standalone de compose (fetch-compose.py,
            // cacheado en el workspace) + build/push al registry local con el
            // tag del build y :latest (docker-compose.registry.yml).
            agent {
                docker {
                    image 'python:3.11-slim'
                    args '-v /var/run/docker.sock:/var/run/docker.sock --group-add 983 --network host'
                }
            }
            steps {
                sh 'python3 scripts/fetch-compose.py'
                // JWT por credencial jwt-secret (el clone no trae .env). Se
                // re-exporta como JWT_SECRET con otro nombre de variable porque
                // JWT_SECRET colisiona con el env del controller (llegaba vacío).
                withCredentials([string(credentialsId: 'jwt-secret', variable: 'JWT_CI')]) {
                    sh 'export JWT_SECRET=$JWT_CI; TAG=${BUILD_NUMBER} scripts/ci-compose.sh -r build empleados-service'
                    sh 'export JWT_SECRET=$JWT_CI; TAG=${BUILD_NUMBER} scripts/ci-compose.sh -r push empleados-service'
                    sh 'export JWT_SECRET=$JWT_CI; TAG=latest scripts/ci-compose.sh -r build empleados-service'
                    sh 'export JWT_SECRET=$JWT_CI; TAG=latest scripts/ci-compose.sh -r push empleados-service'
                }
            }
        }

        stage('E2E Tests') {
            // Stack de app en proyecto compose aislado (reto7-e2e: no toca
            // Jenkins/Sonar/registry del proyecto base). '|| true' tras run_bdd:
            // es junit quien marca UNSTABLE. Los E2E no se paralelizan entre
            // pipelines: comparten puertos fijos del stack (8080) y proyecto.
            agent {
                docker {
                    image 'python:3.11-slim'
                    args '-v /var/run/docker.sock:/var/run/docker.sock --group-add 983 --network host'
                }
            }
            steps {
                sh 'python3 scripts/fetch-compose.py'
                withCredentials([string(credentialsId: 'jwt-secret', variable: 'JWT_CI')]) {
                    sh 'export JWT_SECRET=$JWT_CI; scripts/ci-compose.sh up -d --build api-gateway'
                }
                sh 'BASE_URL=http://localhost:8080 python3 scripts/wait-for-e2e-ready.py'
                sh 'cd e2e-tests && ([ -x .venv/bin/behave ] || (python3 -m venv .venv && .venv/bin/pip install -q -r requirements.txt)) && BASE_URL=http://localhost:8080 ./run_bdd.sh || true'
            }
            post {
                always {
                    junit 'e2e-tests/reports/TESTS-*.xml'
                    cucumber(jsonReportDirectory: 'e2e-tests/reports', fileIncludePattern: '**/cucumber.json', buildStatus: 'UNSTABLE')
                    publishHTML(target: [reportDir: 'e2e-tests/reports', reportFiles: 'cucumber.html', reportName: 'Reporte BDD', keepAll: true, alwaysLinkToLastBuild: true])
                    withCredentials([string(credentialsId: 'jwt-secret', variable: 'JWT_CI')]) {
                        sh 'export JWT_SECRET=$JWT_CI; scripts/ci-compose.sh logs --no-color > docker-logs.txt || true'
                        sh 'export JWT_SECRET=$JWT_CI; scripts/ci-compose.sh down -v || true'
                    }
                    archiveArtifacts artifacts: 'docker-logs.txt', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline finalizado'
        }
        success {
            echo 'Build y tests exitosos'
        }
        unstable {
            echo 'El build compiló pero hay pruebas fallando'
        }
        failure {
            echo 'El pipeline ha fallado'
        }
    }
}
