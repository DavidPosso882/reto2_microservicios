<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Reto 8: logs JSON en una línea por evento. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="com.empresa.gestionempleados.observability.JsonLogEncoder"/>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
