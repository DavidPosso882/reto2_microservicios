DB_EMPLEADOS_NAME=gestion_empleados
DB_EMPLEADOS_USER=postgres
DB_EMPLEADOS_PASSWORD=postgres
DB_DEPARTAMENTOS_NAME=departamentos
DB_DEPARTAMENTOS_USER=postgres
DB_DEPARTAMENTOS_PASSWORD=postgres

RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
DB_NOTIFICACIONES_NAME=notificaciones
DB_NOTIFICACIONES_USER=postgres
DB_NOTIFICACIONES_PASSWORD=postgres
DB_PERFILES_NAME=perfiles
DB_PERFILES_USER=postgres
DB_PERFILES_PASSWORD=postgres
DB_VACACIONES_NAME=vacaciones
DB_VACACIONES_USER=postgres
DB_VACACIONES_PASSWORD=postgres

# Reto 8 T3: alertas Telegram (BotFather + chat_id). Vacío = sin envío.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firmado JWT (gateway + autenticación). OBLIGATORIO: 64 hex de `openssl rand -hex 32`.
# El compose aborta (fail-fast) si queda vacío. Generarlo con scripts/setup-secrets.sh.
JWT_SECRET=__GENERAR_CON_scripts_setup-secrets_sh__
DB_AUTH_NAME=auth_db
DB_AUTH_USER=postgres
DB_AUTH_PASSWORD=postgres

# Grafana local (solo desarrollo). En producción, sobrescribir por entorno/Vault.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# SonarQube (CI calidad, JCasC lo usa como credencial). Vacío = quality gate local.
SONAR_TOKEN=
