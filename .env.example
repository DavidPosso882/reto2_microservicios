# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de configuración local. NO contiene secretos reales.
#
#   cp .env.example .env            # (o deja que el script lo haga)
#   bash scripts/setup-secrets.sh   # genera secrets/ y completa las contraseñas
#
# Dónde vive cada credencial:
#   secrets/jwt_secret                  → firma de los JWT (auth-service, api-gateway, Jenkins)
#   secrets/db_<servicio>_password      → contraseña de cada PostgreSQL (Docker secrets)
#   secrets/grafana_admin_password      → contraseña del admin de Grafana
#   secrets/jenkins_admin_password      → contraseña del usuario admin de Jenkins
#   .env (este archivo, ya copiado)     → lo que no admite *_FILE (ver abajo)
#
# .env y secrets/ están en .gitignore. Las plantillas de secrets/ están en
# secrets.example/.
# ─────────────────────────────────────────────────────────────────────────────

# ── Bases de datos (nombres y usuarios; las contraseñas están en secrets/) ──
DB_AUTH_NAME=auth_db
DB_AUTH_USER=postgres
DB_EMPLEADOS_NAME=gestion_empleados
DB_EMPLEADOS_USER=postgres
DB_DEPARTAMENTOS_NAME=departamentos
DB_DEPARTAMENTOS_USER=postgres
DB_NOTIFICACIONES_NAME=notificaciones
DB_NOTIFICACIONES_USER=postgres
DB_PERFILES_NAME=perfiles
DB_PERFILES_USER=postgres
DB_VACACIONES_NAME=vacaciones
DB_VACACIONES_USER=postgres

# ── RabbitMQ (la imagen no lee *_FILE: la contraseña va aquí) ──
# Vacía en la plantilla: setup-secrets.sh genera un valor aleatorio.
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=

# ── Grafana (la contraseña está en secrets/grafana_admin_password) ──
GRAFANA_ADMIN_USER=admin

# ── SonarQube ──
# SONAR_DB_PASSWORD: contraseña de su PostgreSQL (setup-secrets.sh la genera).
# SONAR_TOKEN: token de análisis; se crea a mano en http://localhost:9000
#   (My Account → Security → Generate Token) y se pega aquí.
SONAR_DB_PASSWORD=
SONAR_TOKEN=

# ── Alertas Grafana → Telegram (Reto 8). Vacío = alertas sin envío. ──
# TELEGRAM_BOT_TOKEN: lo entrega @BotFather. TELEGRAM_CHAT_ID: id del chat destino.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
